{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Bridge",
  "version": "0.1.1",
  "identifier": "com.hikari.screenbridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Screen Bridge",
        "width": 560,
        "height": 640,
        "resizable": false,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
